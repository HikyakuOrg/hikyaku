
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=sb_publishable_xxxx


# Leave blank to use default OSM tiles
NEXT_PUBLIC_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

NEXT_PUBLIC_HIKYAKU_API_URL=http://localhost:3002

# Tenant root domain. Tenants are reached at <slug>.<root>.
#   prod:  hikyaku.org
#   local: localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=hikyaku.org

# Shared secret with the Cloudflare Worker in workers/tenant-proxy, which serves
# the <slug>.hikyaku.org vanity hosts. The middleware only believes the tenant
# host the Worker forwards when this matches, so it must be identical in both
# places. Generate with: openssl rand -hex 32
# Leave unset locally: subdomains resolve straight to the dev server, so the Host
# header is already correct and no proxy is involved.
TENANT_PROXY_SECRET=

# Google OAuth web client ID, from Google Cloud Console > Credentials.
# Drives the "Sign in with Google" button and One Tap on the auth pages; the
# buttons render only once this is set. The matching client secret is NOT used
# by this app: paste it into the Supabase dashboard instead, under
# Authentication > Providers > Google. Add this same client ID to that provider's
# "Authorized Client IDs" field, or signInWithIdToken will reject the token.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Shows the "Add security key" control in account settings. WebAuthn MFA
# enrollment is disabled by default on Supabase projects and there's no
# Dashboard toggle for it yet, so this must line up with a manual Management
# API call: PATCH /v1/projects/<ref>/config/auth with
# {"mfa_web_authn_enroll_enabled": true, "mfa_web_authn_verify_enabled": true}.
# Leave unset/false until that's confirmed enabled server-side, or the button
# will fail with "MFA enroll is disabled for WebAuthn".
NEXT_PUBLIC_WEBAUTHN_MFA_ENABLED=true
