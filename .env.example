
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=sb_publishable_xxxx


# Leave blank to use default OSM tiles
NEXT_PUBLIC_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

NEXT_PUBLIC_HIKYAKU_API_URL=http://localhost:3002

# Tenant root domain. Tenants are reached at <slug>.<root>.
#   prod:  hikyaku.org
#   local: localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=hikyaku.org

# Google OAuth web client ID, from Google Cloud Console > Credentials.
# Drives the "Sign in with Google" button and One Tap on the auth pages; the
# buttons render only once this is set. The matching client secret is NOT used
# by this app: paste it into the Supabase dashboard instead, under
# Authentication > Providers > Google. Add this same client ID to that provider's
# "Authorized Client IDs" field, or signInWithIdToken will reject the token.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
